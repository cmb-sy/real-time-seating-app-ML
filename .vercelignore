# Python cache files
**/__pycache__/
*.pyc
*.pyo
*.pyd
**/*.py[cod]
**/*$py.class

# Virtual environments (最重要: 418MBを除外)
.venv/
venv/
env/
ENV/
.env

# IDE files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Git files
.git/
.gitignore

# ML training files (推論には不要)
src/ml/
!src/ml/__init__.py

# Data files (exclude training data, keep models)
data/
frontend_data/
*.csv
*.xlsx
*.db
*.sqlite3

# Documentation (README以外)
documents/
*.md
!README.md

# Test files
*.html
api_test.html
test_*.py
*_test.py

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Images
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Training scripts (推論には不要)
main.py
scheduler.py
start_server.py
clean_cache.py
install_minimal.sh

# Temporary files
*.tmp
*.temp
*.log
*.bak

# Package management
uv.lock
poetry.lock
Pipfile.lock
pyproject.toml

# GitHub Actions (デプロイには不要)
.github/

# Vercel files
.vercel/

# Python dependencies (requirements.txtから再インストール)
site-packages/

# Large libraries (必要最小限のみ残す)
**/numpy/tests/
**/pandas/tests/
**/sklearn/tests/
**/scipy/tests/
**/matplotlib/
**/seaborn/
**/plotly/

# Development tools
**/pytest/
**/black/
**/flake8/
**/mypy/

# Unused model files (必要なもののみ残す)
# *.joblib は残す（APIで必要）

# Public directory
public/

# Runtime files
runtime.txt 