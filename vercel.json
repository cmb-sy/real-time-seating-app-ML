{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.10" }
    }
  ],
  "functions": {
    "api/index.py": { "runtime": "python3.10" }
  },
  "routes": [
    { "src": "/api/predictions/(.*)", "dest": "api/index.py" },
    { "src": "/api/model-info", "dest": "api/index.py" },
    { "src": "/api/(.*)", "dest": "api/index.py" }
  ]
}
