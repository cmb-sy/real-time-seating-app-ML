{
  "version": 2,
  "builds": [
    {
      "src": "src/api/api_router.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "pipInstallArgs": "-r requirements-vercel.txt"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/predictions/today-tomorrow",
      "dest": "src/api/api_router.py"
    },
    {
      "src": "/api/predictions/weekly-average",
      "dest": "src/api/api_router.py"
    },
    {
      "src": "/predictions/today-tomorrow",
      "dest": "src/api/api_router.py"
    },
    {
      "src": "/predictions/weekly-average",
      "dest": "src/api/api_router.py"
    },
    {
      "src": "/",
      "dest": "src/api/api_router.py"
    }
  ]
}
