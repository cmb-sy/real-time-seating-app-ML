{
  "version": 2,
  "functions": {
    "api/*.py": {
      "runtime": "python3.12"
    }
  },
  "routes": [
    {
      "src": "/api/predictions/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/model-info",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
