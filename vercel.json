{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python"
    }
  },
  "routes": [
    {
      "src": "/api/predictions/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/model-info",
      "dest": "/api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "build": {
    "env": {
      "PYTHONPATH": "."
    }
  }
}
